# Never commit real values. Use Replit Secrets for BOT_TOKEN.
BOT_TOKEN=

# Absolute HTTPS URL opened by the Telegram Mini App button.
# In Replit development, the bot can derive this from REPLIT_DEV_DOMAIN
# when MINI_APP_URL is not set.
MINI_APP_URL=

# Use polling locally and webhook in production to avoid duplicate bot instances.
TELEGRAM_BOT_MODE=polling

# Optional. Defaults to <MINI_APP_URL origin>/api/telegram/webhook.
TELEGRAM_WEBHOOK_URL=