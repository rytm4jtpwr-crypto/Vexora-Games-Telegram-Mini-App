modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MINI_APP_URL = "https://vexora-games-telegram-mini-app--nyruknyruk75.replit.app/"

[userenv.development]
TELEGRAM_BOT_MODE = "polling"

[userenv.production]
TELEGRAM_BOT_MODE = "webhook"
